# ==========================================================
#  LoginAuthentication — Environment Variables
#  Copy this file to ".env" in the project root and fill in
#  real values. Never commit your actual ".env" file.
# ==========================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local:  mongodb://127.0.0.1:27017/login-auth-system
# Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/login-auth-system
MONGO_URI=mongodb://127.0.0.1:27017/login-auth-system

# JWT (Access Token)
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# JWT (Refresh Token)
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# "Remember Me" extends the refresh token lifetime when checked at login
JWT_REMEMBER_EXPIRES_IN=30d

# Password Reset Tokens
RESET_TOKEN_EXPIRES_IN_MIN=30

# CORS — the origin your frontend is served from
CLIENT_ORIGIN=http://127.0.0.1:5500

# Cookie security (set COOKIE_SECURE=true only when serving over HTTPS)
COOKIE_SECURE=false
